# Copy to .env and fill in. Never commit .env (see .gitignore).
# Full variable reference: ../sudoku-server-spec.md section 3.

# Required
SUDOKU_DB_URL=jdbc:postgresql://host.docker.internal:5432/sudoku
SUDOKU_DB_USER=sudoku
SUDOKU_DB_PASSWORD=
BOOTSTRAP_INVITE=

# Optional - shown with their defaults
#SUDOKU_PORT=7000
#SUDOKU_DB_POOL_SIZE=10
#SUDOKU_SERVER_NAME=Sudoku Server
#SUDOKU_TIMEZONE=UTC
#SUDOKU_DAILY_SIZE=9
# The server always speaks plain HTTP; nginx terminates TLS in front of it.
# Leave this on unless the server is directly reachable, in which case the proxy headers would be
# client-controlled and must not be believed.
#SUDOKU_TRUST_PROXY=true
#SUDOKU_DUEL_INITIAL_BANK=90
#SUDOKU_DUEL_GAIN_CORRECT=6
#SUDOKU_DUEL_LOSS_INCORRECT=20
#SUDOKU_DUEL_MAX_BANK=180
#SUDOKU_DUEL_MIN_TURN=10
#SUDOKU_DUEL_REGEN_RATIO=0.5
#SUDOKU_DUEL_MAX_HANDOVERS=40
#SUDOKU_MATCH_RECONNECT_GRACE=60
#SUDOKU_MATCH_RECONNECT_LIMIT=3
#SUDOKU_CURRENCY_DAILY_GAME_CAP=10
